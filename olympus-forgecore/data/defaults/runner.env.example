# One file per GitHub repository.
# Copy this file to:
#   <APP_DATA_DIR>/data/config/runners/<name>.env
#
# Get a fresh repository registration token from:
# GitHub repository -> Settings -> Actions -> Runners -> New self-hosted runner.
#
# ForgeCore clears REGISTRATION_TOKEN after successful registration,
# before the runner starts accepting jobs.

REPOSITORY="Jojje84/UniCore"
REGISTRATION_TOKEN=""
NAME=""
LABELS="beelink,forgecore,unicore-build"
