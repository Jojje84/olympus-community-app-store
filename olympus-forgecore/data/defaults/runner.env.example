# One file per GitHub repository.
# Prefer the ForgeCore dashboard for normal setup.
# Manual fallback: copy this file to:
#   <APP_DATA_DIR>/data/config/runners/<name>.env
#
# Get a fresh repository registration token from:
# GitHub repository -> Settings -> Actions -> Runners -> New self-hosted runner.
#
# ForgeCore clears REGISTRATION_TOKEN after each registration attempt.

REPOSITORY=""
REGISTRATION_TOKEN=""
NAME=""
LABELS="beelink,forgecore"
